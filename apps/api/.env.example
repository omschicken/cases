# Copy to .env and fill in real values. Never commit real secrets.

# Supabase transaction pooler URL for runtime queries (port 6543).
# connection_limit=1 is REQUIRED for Vercel serverless — each function instance
# must not hold more than one connection or the pool (size 15) will be exhausted.
# pool_timeout=0 prevents Prisma from queuing and blocking the function.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=0"
# Direct Supabase connection for Prisma migrations (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

PORT=4000
WEB_ORIGIN="http://localhost:5173"

# --- Steam login ---
API_PUBLIC_URL="http://localhost:4000"
STEAM_API_KEY=""

PAYMENTS_CARD_PROVIDER="mock"
PAYMENTS_CRYPTO_PROVIDER="mock"
PAYMENTS_STEAM_PROVIDER="mock"
KYC_PROVIDER="mock"

USD_TO_RUB_RATE="95"

ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

LICENSE_JURISDICTION="LATAM"
LICENSE_NUMBER=""
LICENSE_STATUS="pending"
