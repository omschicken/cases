# Copy to .env and fill in real values. Never commit real secrets.

DATABASE_URL="postgresql://cs2cases:cs2cases@localhost:5432/cs2cases?schema=public"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

PORT=4000
WEB_ORIGIN="http://localhost:5173"

# --- Steam login ---
# Must be an internet-reachable URL Steam can redirect back to (so not
# localhost in production) — e.g. your Railway API domain.
API_PUBLIC_URL="http://localhost:4000"
# Optional: without it, Steam logins still work, just with a generic
# display name/avatar instead of the player's real persona name/picture.
# Free key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# --- Payment rails: pluggable adapters, mock implementations ship by default ---
PAYMENTS_CARD_PROVIDER="mock"     # switch to a real PSP adapter id once licensed & contracted
PAYMENTS_CRYPTO_PROVIDER="mock"   # e.g. real crypto payment processor adapter id
PAYMENTS_STEAM_PROVIDER="mock"    # real Steam bot/trade adapter id; needs bot accounts + inventory

# --- KYC: pluggable provider, mock implementation ships by default ---
KYC_PROVIDER="mock"               # real identity-verification provider id

# --- Skin price sync (see src/prices) ---
# Runs daily against Steam's public market API (no key needed) and pushes
# fresh prices to every case that carries a given skin. Trigger a pass
# on-demand with POST /admin/prices/sync (admin-only), check progress with
# GET /admin/prices/status.
USD_TO_RUB_RATE="95"              # used only to convert the fetched USD price for RUB-tagged cases; update as the real rate moves

# --- One-time admin bootstrap (see src/admin/admin-bootstrap.service.ts) ---
# On every boot, if set: creates this account as ADMIN if it doesn't exist
# yet, or promotes it to ADMIN if it does (never touches an existing
# account's password). Set both on the Railway service, redeploy/restart
# once, then unset them again — leaving them set just keeps re-promoting
# the same account on every future boot, which is harmless but needless.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# --- Gambling license reference (for audit trail / footer display) ---
LICENSE_JURISDICTION="LATAM"
LICENSE_NUMBER=""
LICENSE_STATUS="pending"
